@model IEnumerable<BeFit.Models.ExerciseStat>

@{
    ViewData["Title"] = "Index";
}

<h1>Statystyki z 4 tygodni</h1>

<table class="table">

<thead>
<tr>
    <th>Ćwiczenie</th>
    <th>Ile razy wykonano</th>
    <th>Łącznie powtórzeń</th>
    <th>Średnie obciążenie</th>
    <th>Maksymalne obciążenie</th>
</tr>
</thead>

<tbody>

@foreach(var item in Model)
{
<tr>
    <td>@item.ExerciseName</td>

    <td>@item.TimesPerformed</td>

    <td>@item.TotalRepetitions</td>

    <td>@item.AverageWeight</td>

    <td>@item.MaxWeight</td>
</tr>
}

</tbody>
</table>